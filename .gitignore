# Superseded monolithic stage-gallery/world authoring scenes. The final
# per-stage sources live under blender/stage-overhaul/ and remain tracked.
_workspace/**/blender/abyssal-surge-stage-gallery-v*.blend
_workspace/**/blender/abyssal-surge-stage-worlds-v*.blend

# Superseded gallery patch scripts and contact-sheet bookkeeping. Canonical
# stage construction is scripts/build-authored-stage-environments.py plus the
# tracked stage-overhaul source/evidence.
_workspace/**/blender/apply_gallery_toon.py

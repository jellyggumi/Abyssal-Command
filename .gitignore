_workspace/**/engineering/asset-pipeline/player-combat-animation-candidate/*.glb
_workspace/**/engineering/asset-pipeline/all-mesh-texture-candidates/
_workspace/**/engineering/asset-pipeline/all-mesh-texture-candidates-v2/bosses/
_workspace/**/engineering/asset-pipeline/all-mesh-texture-candidates-v2/commander/

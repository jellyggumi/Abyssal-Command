{
  "schemaVersion": "asset-lanes-v1",
  "purpose": "Keep concept/reference inputs, deployed runtime resources, and unshipped candidates in separate lanes.",
  "repositoryRelative": true,
  "markers": {
    "conceptPathSegments": [
      "concept",
      "concepts",
      "pilot",
      "reference",
      "references",
      "prompt",
      "prompts"
    ],
    "conceptFilePrefixes": [
      "concept-",
      "concept_",
      "concept."
    ]
  },
  "lanes": {
    "concept": {
      "description": "Source/reference images, prompts, visual studies, and other non-runtime pipeline inputs.",
      "paths": [
        { "path": "assets/images/battle/pilot", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/visual", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/angle-representatives", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/rodin-tpose-conditions", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/qa/bind-pose-frames", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/concepts", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/prompts", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/references", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/design", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/intake", "recursive": true },
        { "path": "_workspace/20260726-tpose-rig-animation/production", "recursive": true }
      ],
      "allowedExtensions": [
        ".blend",
        ".glb",
        ".jpeg",
        ".jpg",
        ".json",
        ".md",
        ".png",
        ".svg",
        ".txt",
        ".webp"
      ],
      "runtimeEligible": false,
      "forbiddenRuntimeUse": true
    },
    "runtime": {
      "description": "Already deployed resources and paths consumed by the live renderer or runtime asset manifest.",
      "paths": [
        { "path": "assets/defense-asset-manifest.json", "recursive": false },
        { "path": "assets/icons", "recursive": true },
        { "path": "assets/images/battle", "recursive": false },
        { "path": "assets/images/battle/glb", "recursive": true },
        { "path": "assets/images/battle/world", "recursive": true },
        { "path": "assets/audio", "recursive": true }
      ],
      "excludedPaths": [
        {
          "path": "assets/images/battle/world/concept-sung-hum-boss.provenance.json",
          "reason": "Legacy misplaced concept provenance metadata; it is not a runtime resource."
        }
      ],
      "allowedExtensions": [
        ".flac",
        ".glb",
        ".jpeg",
        ".jpg",
        ".json",
        ".m4a",
        ".mp3",
        ".ogg",
        ".png",
        ".wav",
        ".webp"
      ],
      "forbiddenConceptMarkers": {
        "pathSegments": [
          "concept",
          "concepts",
          "pilot",
          "reference",
          "references",
          "prompt",
          "prompts"
        ],
        "filePrefixes": [
          "concept-",
          "concept_",
          "concept."
        ]
      },
      "requiredSidecarFields": [
        "runtimeEligible",
        "source",
        "generator",
        "output",
        "rightsReceipt",
        "runtimeReceipt"
      ],
      "deployedAssets": {
        "sidecarRequired": false,
        "reason": "Existing deployed resources retain their established IDs and paths; provenance is required before a candidate is promoted into this lane."
      }
    },
    "candidate": {
      "description": "Unshipped generated outputs staged for review; candidates are never runtime resources.",
      "paths": [
        { "path": "_workspace/20260726-tpose-rig-animation/runtime-candidates", "recursive": true }
      ],
      "allowedExtensions": [
        ".blend",
        ".flac",
        ".glb",
        ".jpeg",
        ".jpg",
        ".json",
        ".m4a",
        ".md",
        ".mp3",
        ".ogg",
        ".png",
        ".svg",
        ".wav",
        ".webp"
      ],
      "artifactExtensions": [
        ".blend",
        ".flac",
        ".glb",
        ".jpeg",
        ".jpg",
        ".m4a",
        ".mp3",
        ".ogg",
        ".png",
        ".svg",
        ".wav",
        ".webp"
      ],
      "sidecar": {
        "suffix": ".provenance.json",
        "requiredFields": [
          "runtimeEligible",
          "source",
          "generator",
          "output",
          "rightsReceipt",
          "runtimeReceipt"
        ],
        "runtimeEligibleValue": true
      }
    }
  }
}
